# Required: the token @BotFather gives you.
BOT_TOKEN=123456789:replace-with-your-token

# Your Telegram user id (ask @userinfobot). Comma-separate several admins.
# Admins can use /stats, /feeds and /broadcast.
ADMIN_IDS=

